#include <windows.h>
#include "resource.h"

IDD_OPTIONS_DLG DIALOG 0, 0, 200, 130
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Communication Settings"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "Protocol:", -1, 15, 15, 40, 8
    COMBOBOX        IDC_COMBO_TYPE, 65, 13, 115, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Parameters", -1, 10, 40, 180, 60

    // 槽位 1
    LTEXT           "IP Address:", IDC_STATIC_LABEL_1, 20, 55, 45, 8
    EDITTEXT        IDC_EDIT_IP, 70, 53, 110, 12, ES_AUTOHSCROLL
    COMBOBOX        IDC_COMBO_COM, 70, 53, 110, 100, CBS_DROPDOWNLIST | NOT WS_VISIBLE | WS_VSCROLL | WS_TABSTOP

    // 槽位 2
    LTEXT           "Port:", IDC_STATIC_LABEL_2, 20, 78, 45, 8
    EDITTEXT        IDC_EDIT_PORT, 70, 76, 50, 12, ES_NUMBER
    COMBOBOX        IDC_COMBO_BAUD, 70, 76, 70, 100, CBS_DROPDOWNLIST | NOT WS_VISIBLE | WS_VSCROLL | WS_TABSTOP

    DEFPUSHBUTTON   "OK", IDOK, 85, 110, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 140, 110, 50, 14
END